APP_NAME="Elearning Lab"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1
APP_PORT=80
RUN_MIGRATIONS=1
CACHE_CONFIG=1

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=elearning
DB_USERNAME=app
DB_PASSWORD=elearning
MYSQL_USER=app
MYSQL_ROOT_PASSWORD=elearning

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=s3
UPLOAD_DISK=s3
# Để trống — EC2 dùng instance profile (role elearning-ec2-app)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
