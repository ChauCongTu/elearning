APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
UPLOAD_DISK=public
# When UPLOAD_DISK=s3, media URLs are signed S3 links (not /storage/...)
UPLOAD_URL_TTL_MINUTES=120
CERTIFICATE_EMAIL_ATTACH_PDF=false
CERTIFICATE_ORGANIZATION="Học Viện Bông Nhài Trắng"
CERTIFICATE_ORGANIZATION_SHORT="Học Viện Bông Nhài Trắng"
CERTIFICATE_LATEX_BINARY=pdflatex
VIDEO_DISK=
VIDEO_SIGNED_URL_TTL=120
VIDEO_WATERMARK_ENABLED=true
VIDEO_WATERMARK_MIN_INTERVAL=90
VIDEO_WATERMARK_MAX_INTERVAL=210
VIDEO_WATERMARK_MIN_VISIBLE=5
VIDEO_WATERMARK_MAX_VISIBLE=10
VIDEO_WATERMARK_INITIAL_DELAY_MIN=30
VIDEO_WATERMARK_INITIAL_DELAY_MAX=75
VIDEO_CAPTURE_GUARD_ENABLED=true
VIDEO_CAPTURE_GUARD_PAUSE_ON_HIDDEN=true
VIDEO_CAPTURE_GUARD_BLOCK_SHORTCUTS=true
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Optional per-case mail from overrides (default: MAIL_FROM_* above)
# MAIL_FROM_REGISTRATION=
# MAIL_FROM_REGISTRATION_NAME=
# MAIL_FROM_EMAIL_VERIFICATION=
# MAIL_FROM_EMAIL_VERIFICATION_NAME=
# MAIL_FROM_ORDER_CREATED=
# MAIL_FROM_ORDER_CREATED_NAME=
# MAIL_FROM_ORDER_PAID=
# MAIL_FROM_ORDER_PAID_NAME=
# MAIL_FROM_ORDER_EXPIRED=
# MAIL_FROM_ORDER_EXPIRED_NAME=
# MAIL_FROM_COURSE_COMPLETED=
# MAIL_FROM_COURSE_COMPLETED_NAME=
# MAIL_FROM_ROLE_CHANGED=
# MAIL_FROM_ROLE_CHANGED_NAME=
# MAIL_FROM_ENROLLMENT_GRANTED=
# MAIL_FROM_ENROLLMENT_GRANTED_NAME=
# BCC admin on order emails (comma-separated)
MAIL_ORDER_ADMIN_BCC=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SePay / VietQR
SEPAY_BANK_CODE=Vietcombank
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Webhook API Key — để trống, sinh bằng: php artisan sepay:rotate-webhook-key
# .env chỉ lưu bản mã hóa (enc:...). Plaintext chỉ hiện một lần khi chạy lệnh.
SEPAY_WEBHOOK_API_KEY=
SEPAY_QR_BASE_URL=https://vietqr.app/img
SEPAY_ORDER_CODE_PREFIX=ELN
SEPAY_PAYMENT_EXPIRY_MINUTES=15
